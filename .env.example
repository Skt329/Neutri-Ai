# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://your-project.supabase.co

# ─── Azure OpenAI ─────────────────────────────────────────────────────────────
AZURE_RESOURCE_NAME=your-azure-resource
AZURE_API_KEY=your-azure-api-key

# ─── NVIDIA NIM (Embeddings) ─────────────────────────────────────────────────
NIM_API_KEY=your-nim-api-key

# ─── USDA FoodData Central ───────────────────────────────────────────────────
USDA_API_KEY=your-usda-api-key

# ─── Upstash Redis (Rate Limiting & Caching) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ─── Swiggy OAuth Integration ───────────────────────────────────────────────
SWIGGY_CLIENT_ID=your-swiggy-client-id
SWIGGY_TOKEN_ENCRYPTION_KEY=your-64-char-hex-key

# ─── Cron Jobs ───────────────────────────────────────────────────────────────
CRON_SECRET=your-cron-secret

# ─── App Configuration ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# ─── Prisma (Local Development) ──────────────────────────────────────────────
DATABASE_URL=prisma+postgres://localhost:51213/?api_key=...

# ─── Sentry (Error Tracking) ─────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Required for source map uploads (CI only):
# SENTRY_AUTH_TOKEN=your-sentry-auth-token
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project

# ─── Debug ───────────────────────────────────────────────────────────────────
# DEBUG=true
